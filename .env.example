# Copia este archivo a .env y completa los valores de tu proyecto de
# Supabase (Project Settings -> API, en supabase.com/dashboard).
#
# Estas variables son publicas por diseno: la anon key queda expuesta
# en el bundle del navegador a proposito, la seguridad real la da Row
# Level Security (RLS) en la base de datos, no el secreto de esta clave.
#
# IMPORTANTE: el Client Secret de Google NUNCA va aca. Ese secreto se
# configura una sola vez en el panel de Supabase (Authentication ->
# Providers -> Google).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Unico filtro de acceso de esta app: el email de Google del presidente.
# Cualquier otra cuenta que inicie sesion vera la pantalla "no autorizado".
VITE_PRESIDENTE_EMAIL=presidente@emcoex.com
